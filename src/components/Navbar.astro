---
import Icon from './Icon.astro'
import { NAV_LINKS } from '../config'
---
<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-[background-color,backdrop-filter,border-color,box-shadow] duration-300"
>
  <nav
    class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:h-20 sm:px-6 lg:px-8"
    aria-label="Navegación principal"
  >
    <a href="#inicio" class="group flex items-center gap-2.5" aria-label="LUX Eventos - Inicio">
      <span
        class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-purple-500 to-purple-700 font-display text-lg font-extrabold text-cream-50 shadow-glow transition-transform group-hover:scale-105"
      >
        L
      </span>
      <span class="flex flex-col leading-none">
        <span class="font-display text-lg font-bold tracking-tight text-white">
          LUX<span class="text-purple-300"> Eventos</span>
        </span>
        <span class="text-[10px] font-medium uppercase tracking-[0.2em] text-beige-300">
          Producciones
        </span>
      </span>
    </a>

    <div class="hidden items-center gap-8 lg:flex">
      <ul class="flex items-center gap-7">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm font-medium text-beige-300 transition-colors hover:text-purple-300"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <button
        type="button"
        data-open-quote
        class="press relative inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-orange-500 to-red-500 px-4 py-2.5 text-sm font-semibold text-white shadow-glow-warm transition-all hover:scale-[1.03] hover:shadow-none"
      >
        <Icon name="message-circle" class="h-4 w-4" />
        Cotizar Evento
        <span id="quote-badge" hidden class="absolute -right-2 -top-2 flex h-5 min-w-5 items-center justify-center rounded-full bg-purple-400 px-1 text-[10px] font-bold text-night-950">
        </span>
      </button>
    </div>

    <button
      id="menu-button"
      type="button"
      class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-white lg:hidden"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <Icon name="menu" class="h-5 w-5" data-menu-open="" />
      <Icon name="x" class="hidden h-5 w-5" data-menu-close="" />
    </button>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-white/10 bg-night-950/90 backdrop-blur-2xl lg:hidden">
    <ul class="mx-auto flex max-w-7xl flex-col gap-1 px-4 py-6">
      {
        NAV_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              class="block w-full rounded-lg px-3 py-3 text-base font-medium text-beige-200 transition-colors hover:bg-white/5 hover:text-purple-300"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="mt-3">
        <button
          type="button"
          data-open-quote
          class="press flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-orange-500 to-red-500 px-4 py-3.5 text-base font-semibold text-white"
        >
          <Icon name="message-circle" class="h-5 w-5" />
          Cotizar Evento
        </button>
      </li>
    </ul>
  </div>
</header>

<style>
  /* Translucent chrome: hairline + material weight appear only once content scrolls under. */
  .nav-scrolled {
    @apply border-b border-white/[0.06] bg-night-900/70 shadow-[0_8px_32px_-16px_rgba(0,0,0,0.7)] backdrop-blur-2xl;
  }

  #mobile-menu.open {
    display: block;
  }
</style>