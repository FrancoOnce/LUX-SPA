---
import Icon from './Icon.astro'
---
<section
  id="inicio"
  class="relative flex min-h-screen items-center overflow-hidden pt-24 pb-16 sm:pt-28"
>
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute inset-0 bg-night-950" />
    <div
      class="absolute -top-40 left-1/2 h-[32rem] w-[52rem] -translate-x-1/2 rounded-full bg-[conic-gradient(from_140deg,rgba(139,92,246,0.30),rgba(249,115,22,0.20),rgba(220,38,38,0.16),rgba(139,92,246,0.30))] blur-3xl animate-aurora"
    />
    <div class="absolute bottom-0 left-0 h-[24rem] w-[24rem] rounded-full bg-orange-600/15 blur-[100px]" />
    <div class="absolute right-0 top-1/3 h-[20rem] w-[20rem] rounded-full bg-purple-500/20 blur-[90px]" />
    <div
      class="absolute inset-0 bg-[radial-gradient(rgba(255,255,255,0.05)_1px,transparent_1px)] [background-size:42px_42px] [mask-image:radial-gradient(ellipse_at_center,black_10%,transparent_70%)]"
    />
  </div>

  <div class="mx-auto grid w-full max-w-7xl gap-14 px-4 sm:px-6 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:px-8">
    <div class="max-w-2xl">
      <span
        data-reveal
        class="inline-flex items-center gap-2 rounded-full border border-purple-400/30 bg-purple-400/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-purple-200"
      >
        <Icon name="sparkles" class="h-3.5 w-3.5" />
        Producción de entretenimiento artístico
      </span>

      <h1
        data-reveal
        class="mt-6 font-display text-4xl font-extrabold leading-[1.05] tracking-tight text-white sm:text-6xl lg:text-7xl"
      >
        Haz que tu evento{' '}
        <span class="bg-gradient-to-r from-orange-300 via-red-300 to-purple-400 bg-clip-text text-transparent">
          sea legendario
        </span>
      </h1>

      <p data-reveal class="mt-6 max-w-xl text-lg leading-relaxed text-beige-300 sm:text-xl">
        Shows temáticos, hora loca, plataforma 360°, tótems fotográficos, coreografías y efectos
        especiales. Diseñamos experiencias únicas a la medida de tu celebración.
      </p>

      <div data-reveal class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
        <button
          type="button"
          data-open-quote
          class="group inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-orange-500 to-red-500 px-7 py-4 text-base font-bold text-white shadow-glow-warm transition-all hover:scale-[1.03]"
        >
          Cotizar Ahora
          <Icon name="arrow-right" class="h-5 w-5 transition-transform group-hover:translate-x-1" />
        </button>
        <a
          href="#servicios"
          class="group inline-flex items-center justify-center gap-2 rounded-xl border border-white/10 bg-white/5 px-7 py-4 text-base font-semibold text-white backdrop-blur transition-all hover:border-purple-400/50 hover:bg-white/10"
        >
          <span
            class="flex h-8 w-8 items-center justify-center rounded-full border border-white/20 transition-colors group-hover:border-orange-400 group-hover:text-orange-200"
          >
            <Icon name="play" class="h-3.5 w-3.5 fill-current" />
          </span>
          Ver Shows
        </a>
      </div>

      <div data-reveal class="mt-12 grid grid-cols-3 gap-4 border-t border-white/10 pt-8 sm:gap-6">
        <div>
          <div class="font-display text-3xl font-extrabold text-white sm:text-4xl">
            <span data-count="250" data-suffix="+">0</span>
          </div>
          <div class="mt-1 text-xs font-medium uppercase tracking-wider text-beige-300 sm:text-sm">
            Eventos realizados
          </div>
        </div>
        <div>
          <div class="font-display text-3xl font-extrabold text-white sm:text-4xl">
            <span data-count="30" data-suffix="+">0</span>
          </div>
          <div class="mt-1 text-xs font-medium uppercase tracking-wider text-beige-300 sm:text-sm">
            Temáticas disponibles
          </div>
        </div>
        <div>
          <div class="font-display text-3xl font-extrabold text-white sm:text-4xl">
            <span data-count="99" data-suffix="%">0</span>
          </div>
          <div class="mt-1 text-xs font-medium uppercase tracking-wider text-beige-300 sm:text-sm">
            Clientes felices
          </div>
        </div>
      </div>
    </div>

    <div aria-hidden="true" class="relative hidden lg:block">
      <div
        class="relative mx-auto aspect-[4/5] max-w-md overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-br from-night-800 via-night-900 to-night-950 shadow-2xl"
      >
        <div
          class="absolute inset-0 bg-[conic-gradient(from_180deg,rgba(139,92,246,0.20),rgba(249,115,22,0.14),rgba(220,38,38,0.12),rgba(139,92,246,0.20))] animate-aurora"
        >
        </div>
        <div class="absolute inset-0 flex flex-col items-center justify-center gap-4">
          <div class="flex gap-3">
            <Icon name="star" class="h-10 w-10 fill-orange-400 text-orange-400" />
            <Icon name="star" class="h-10 w-10 fill-orange-400 text-orange-400" />
            <Icon name="star" class="h-10 w-10 fill-orange-400 text-orange-400" />
          </div>
          <p class="px-8 text-center font-display text-lg font-semibold text-white">
            La fiesta perfecta
            <br />
            <span class="bg-gradient-to-r from-cream-100 to-purple-300 bg-clip-text text-transparent">
              empieza aquí
            </span>
          </p>
        </div>
      </div>

      <div
        class="absolute -left-8 top-10 flex animate-float items-center gap-3 rounded-2xl border border-white/10 bg-night-900/90 px-4 py-3 backdrop-blur"
      >
        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-purple-500/20 text-purple-300">
          <Icon name="shield-check" class="h-5 w-5" />
        </span>
        <div>
          <p class="text-sm font-semibold text-white">Operadores certificados</p>
          <p class="text-xs text-beige-300">Seguridad garantizada</p>
        </div>
      </div>

      <div
        class="absolute -right-6 bottom-12 flex animate-float-delayed items-center gap-3 rounded-2xl border border-white/10 bg-night-900/90 px-4 py-3 backdrop-blur"
      >
        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-red-500/20 text-red-300">
          <Icon name="users" class="h-5 w-5" />
        </span>
        <div>
          <p class="text-sm font-semibold text-white">+30 artistas en vivo</p>
          <p class="text-xs text-beige-300">Bailarines y performers</p>
        </div>
      </div>
    </div>
  </div>

  <div aria-hidden="true" class="absolute bottom-6 left-1/2 hidden -translate-x-1/2 sm:block">
    <div class="h-10 w-6 rounded-full border border-white/20 p-1.5">
      <div class="mx-auto h-2 w-1 animate-scroll-dot rounded-full bg-purple-300"></div>
    </div>
  </div>
</section>