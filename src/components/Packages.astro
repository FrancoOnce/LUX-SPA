---
import Icon from './Icon.astro'
import SectionHeading from './SectionHeading.astro'
import { packages } from '../data/packages'
import { formatPrice } from '../lib/format'
---
<section id="paquetes" class="relative scroll-mt-24 py-20 sm:py-28">
  <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
    <div class="absolute right-0 top-1/4 h-[26rem] w-[26rem] rounded-full bg-red-600/10 blur-[120px]" />
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading
      eyebrow="Paquetes todo incluido"
      title="Compara y elige"
      highlight="tu experiencia ideal"
      description="Combinaciones optimizadas para cada tipo de celebración. Todos los paquetes incluyen personal técnico, montaje y desmontaje."
    />

    <div class="mt-12 grid gap-6 lg:grid-cols-4 lg:items-end">
      {
        packages.map((pkg, index) => {
          const isRecommended = Boolean(pkg.recommended)
          const savings = pkg.originalPrice ? pkg.originalPrice - pkg.price : 0
          return (
            <div
              data-reveal
              style={`transition-delay:${index * 80}ms`}
              class={isRecommended ? 'lg:-translate-y-4' : ''}
            >
              <article
                class={`relative flex h-full flex-col overflow-hidden rounded-3xl border p-6 transition-all hover:-translate-y-1.5 ${
                  isRecommended
                    ? 'border-purple-400/50 bg-gradient-to-b from-purple-500/[0.12] via-night-900 to-night-900 shadow-glow'
                    : 'border-white/10 bg-white/[0.04] backdrop-blur hover:border-white/25'
                }`}
              >
                {isRecommended && (
                  <span
                    class="absolute right-5 top-5 inline-flex items-center gap-1.5 rounded-full bg-gradient-to-r from-orange-500 to-red-500 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-white"
                  >
                    <Icon name="sparkles" class="h-3 w-3" />
                    Recomendado
                  </span>
                )}

                <div class="flex items-center gap-2">
                  <Icon name="crown" class={`h-5 w-5 ${isRecommended ? 'text-purple-300' : 'text-beige-300'}`} />
                  <h3 class="font-display text-xl font-bold text-white">{pkg.name}</h3>
                </div>
                <p class="mt-1 text-sm text-beige-300">{pkg.tagline}</p>

                <div class="mt-6">
                  {pkg.originalPrice && (
                    <p class="text-sm text-beige-300 line-through">S/ {formatPrice(pkg.originalPrice)}</p>
                  )}
                  <p class="flex items-baseline gap-1">
                    <span class="text-sm font-semibold text-beige-300">S/</span>
                    <span
                      class={`font-display text-4xl font-extrabold ${isRecommended ? 'bg-gradient-to-r from-cream-100 to-purple-300 bg-clip-text text-transparent' : 'text-white'}`}
                    >
                      {formatPrice(pkg.price)}
                    </span>
                  </p>
                  {savings > 0 && (
                    <p class="mt-1 text-xs font-semibold text-orange-300">Ahorras S/ {formatPrice(savings)}</p>
                  )}
                </div>

                <div class="mt-5 flex gap-4 border-y border-white/10 py-4 text-sm text-beige-200">
                  <span class="flex items-center gap-1.5">
                    <Icon name="clock" class="h-4 w-4 text-purple-300" />
                    {pkg.hours} h
                  </span>
                  <span class="flex items-center gap-1.5">
                    <Icon name="users" class="h-4 w-4 text-purple-300" />
                    {pkg.performers} integrantes
                  </span>
                </div>

                <ul class="mt-5 flex-1 space-y-2.5">
                  {
                    pkg.features.map((feature) => (
                      <li class="flex items-start gap-2.5 text-sm leading-snug text-beige-200">
                        <span
                          class={`mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full ${isRecommended ? 'bg-purple-500/25 text-purple-300' : 'bg-white/10 text-beige-300'}`}
                        >
                          <Icon name="check" class="h-2.5 w-2.5" />
                        </span>
                        {feature}
                      </li>
                    ))
                  }
                </ul>

                <button
                  type="button"
                  data-open-quote
                  data-quote-package={pkg.id}
                  class={`press mt-6 flex w-full items-center justify-center gap-2 rounded-xl px-4 py-3.5 text-sm font-bold transition-all ${
                    isRecommended
                      ? 'bg-gradient-to-r from-orange-500 to-red-500 text-white hover:scale-[1.03] shadow-glow-warm'
                      : 'border border-white/15 bg-white/5 text-white hover:border-purple-400/50 hover:bg-purple-400/10'
                  }`}
                >
                  Seleccionar {pkg.name}
                </button>
              </article>
            </div>
          )
        })
      }
    </div>

    <div data-reveal class="mt-8 text-center text-sm text-beige-300">
      ¿Necesitas algo a medida?{' '}
      <button
        type="button"
        data-open-quote
        class="font-semibold text-purple-300 underline-offset-4 hover:underline"
      >
        Armamos un paquete personalizado para ti
      </button>
      .
    </div>
  </div>
</section>