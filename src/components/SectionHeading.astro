---
import Icon from './Icon.astro'

interface Props {
  eyebrow: string
  title: string
  highlight?: string
  description?: string
  align?: 'center' | 'left'
}

const { eyebrow, title, highlight, description, align = 'center' } = Astro.props
const alignment = align === 'center' ? 'mx-auto text-center items-center' : 'items-start'
---
<div data-reveal class={`flex max-w-2xl flex-col gap-4 ${alignment}`}>
  <span
    class="inline-flex items-center gap-2 rounded-full border border-purple-400/30 bg-purple-400/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-purple-600"
  >
    <Icon name="sparkles" class="h-3.5 w-3.5" />
    {eyebrow}
  </span>
  <h2 class="font-display text-3xl font-bold leading-[1.1] tracking-[-0.02em] text-cream-100 sm:text-4xl sm:tracking-[-0.025em] lg:text-5xl">
    {title}{' '}
    {highlight && (
      <span class="bg-gradient-to-r from-cream-100 via-beige-200 to-purple-400 bg-clip-text text-transparent">
        {highlight}
      </span>
    )}
  </h2>
  {description && <p class="text-base leading-relaxed text-beige-300 sm:text-lg">{description}</p>}
</div>